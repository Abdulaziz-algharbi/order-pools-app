# Used only for `vite build` (production mode). Relative, not absolute:
# nginx serves this SPA and proxies /api/* to the backend from the same
# origin, so the built bundle must not hardcode a host/port — it needs to
# work behind whatever domain nginx is fronting. Local dev (`npm run dev`)
# keeps using the absolute URL in .env, since there's no nginx in front of
# the Vite dev server.
VITE_API_BASE_URL=/api/v1
